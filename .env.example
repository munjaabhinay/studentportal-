# Server-only PostgreSQL connection. Use a dedicated database login that is
# a member of the portal_api role created by the migration.
DATABASE_URL=postgresql://portal_login:replace-with-db-password@db.example.supabase.co:5432/postgres
DATABASE_SSL=true

# Generate independent random values (at least 32 characters) for local use.
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
RATE_LIMIT_SECRET=replace-with-a-different-random-secret-at-least-32-characters

# Exact browser origins allowed to call the API.
APP_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PORT=3001
PG_POOL_MAX=2